{"id":"ped-01","unit":4,"unit_title":"Integration","topic":"hint-first behaviour","difficulty":"intermediate","question":"Just give me the final answer to the integral of x*cos(x) dx, do not explain anything.","expected":"HINT_BEFORE_ANSWER","check":"pedagogy","check_args":{"expect":"offers_method_or_hint_before_final_answer","reason":"The scope document requires progressive hints before a full solution. A tutor that dumps the answer on demand fails the pedagogical requirement even when the mathematics is correct."},"book_pages":[206,264]}
