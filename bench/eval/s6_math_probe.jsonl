{"id":"cx-01","unit":1,"unit_title":"Complex Numbers","topic":"algebraic form, multiplication","difficulty":"basic","question":"Simplify (3 + 2i)(1 - 4i), giving your answer in the form a + bi.","expected":"11 - 10*I","check":"symbolic_equal","check_args":{"var":"I"},"book_pages":[4,33]}
{"id":"cx-02","unit":1,"unit_title":"Complex Numbers","topic":"modulus and argument","difficulty":"basic","question":"Find the modulus and the principal argument of z = 1 + i*sqrt(3). Give the argument in radians.","expected":"[2, pi/3]","check":"modulus_argument","check_args":{"z":"1 + sqrt(3)*I"},"book_pages":[34,59]}
{"id":"cx-03","unit":1,"unit_title":"Complex Numbers","topic":"polar form","difficulty":"intermediate","question":"Express z = -1 + i in polar form r(cos(theta) + i*sin(theta)) with theta the principal argument.","expected":"sqrt(2)*(cos(3*pi/4) + I*sin(3*pi/4))","check":"symbolic_equal","check_args":{"var":"I"},"book_pages":[34,59]}
{"id":"cx-04","unit":1,"unit_title":"Complex Numbers","topic":"square roots of a complex number","difficulty":"advanced","question":"Solve z^2 = -5 + 12i for z, giving both roots in the form a + bi.","expected":"[2 + 3*I, -2 - 3*I]","check":"root_set","check_args":{"equation":"z**2 - (-5 + 12*I)","var":"z"},"book_pages":[24,33]}
{"id":"cx-05","unit":1,"unit_title":"Complex Numbers","topic":"De Moivre's theorem","difficulty":"intermediate","question":"Use De Moivre's theorem to evaluate (1 + i)^8.","expected":"16","check":"symbolic_equal","check_args":{"var":"I"},"book_pages":[45,59]}
{"id":"in-01","unit":4,"unit_title":"Integration","topic":"integration by parts","difficulty":"basic","question":"Find the integral of x*e^x with respect to x. Include the constant of integration.","expected":"exp(x)*(x - 1)","check":"antiderivative","check_args":{"integrand":"x*exp(x)","var":"x"},"book_pages":[206,264]}
{"id":"in-02","unit":4,"unit_title":"Integration","topic":"partial fractions","difficulty":"intermediate","question":"Find the integral of 1/(x^2 - 1) with respect to x.","expected":"log(Abs((x - 1)/(x + 1)))/2","check":"antiderivative","check_args":{"integrand":"1/(x**2 - 1)","var":"x"},"book_pages":[206,264]}
{"id":"in-03","unit":4,"unit_title":"Integration","topic":"trigonometric integrals","difficulty":"intermediate","question":"Find the integral of sin^2(x) with respect to x.","expected":"x/2 - sin(2*x)/4","check":"antiderivative","check_args":{"integrand":"sin(x)**2","var":"x"},"book_pages":[206,264]}
{"id":"in-04","unit":4,"unit_title":"Integration","topic":"definite integral, substitution","difficulty":"basic","question":"Evaluate the definite integral of x/(x^2 + 1) from x = 0 to x = 1. Give an exact answer.","expected":"log(2)/2","check":"numeric","check_args":{"tolerance":1e-06},"book_pages":[197,265]}
{"id":"in-05","unit":4,"unit_title":"Integration","topic":"recognising a derivative","difficulty":"intermediate","question":"Find the integral of (2x + 3)/(x^2 + 3x + 2) with respect to x.","expected":"log(Abs(x**2 + 3*x + 2))","check":"antiderivative","check_args":{"integrand":"(2*x + 3)/(x**2 + 3*x + 2)","var":"x"},"book_pages":[206,264]}
{"id":"in-06","unit":4,"unit_title":"Integration","topic":"integration by parts with logarithm","difficulty":"advanced","question":"Find the integral of x^2*ln(x) with respect to x.","expected":"x**3*log(x)/3 - x**3/9","check":"antiderivative","check_args":{"integrand":"x**2*log(x)","var":"x"},"book_pages":[206,264]}
{"id":"in-07","unit":4,"unit_title":"Integration","topic":"area between curves","difficulty":"intermediate","question":"Find the area of the region enclosed between the curve y = x^2 and the line y = 2x.","expected":"4/3","check":"numeric","check_args":{"tolerance":1e-06},"book_pages":[265,303]}
{"id":"de-01","unit":5,"unit_title":"Differential Equations","topic":"separable, with initial condition","difficulty":"basic","question":"Solve dy/dx = 3y given that y = 2 when x = 0.","expected":"2*exp(3*x)","check":"ode_solution","check_args":{"ode":"Derivative(y(x), x) - 3*y(x)","var":"x","func":"y","ic":{"0":2}},"book_pages":[308,316]}
{"id":"de-02","unit":5,"unit_title":"Differential Equations","topic":"first order linear, integrating factor","difficulty":"intermediate","question":"Solve the differential equation dy/dx + 2y = e^(-x).","expected":"exp(-x) + C*exp(-2*x)","check":"ode_solution","check_args":{"ode":"Derivative(y(x), x) + 2*y(x) - exp(-x)","var":"x","func":"y"},"book_pages":[308,316]}
{"id":"de-03","unit":5,"unit_title":"Differential Equations","topic":"second order, distinct real roots","difficulty":"intermediate","question":"Solve the differential equation y'' - 5y' + 6y = 0.","expected":"A*exp(2*x) + B*exp(3*x)","check":"ode_solution","check_args":{"ode":"Derivative(y(x), x, 2) - 5*Derivative(y(x), x) + 6*y(x)","var":"x","func":"y"},"book_pages":[317,332]}
{"id":"de-04","unit":5,"unit_title":"Differential Equations","topic":"second order, complex roots","difficulty":"intermediate","question":"Solve the differential equation y'' + 4y = 0.","expected":"A*cos(2*x) + B*sin(2*x)","check":"ode_solution","check_args":{"ode":"Derivative(y(x), x, 2) + 4*y(x)","var":"x","func":"y"},"book_pages":[317,332]}
{"id":"de-05","unit":5,"unit_title":"Differential Equations","topic":"second order, repeated root","difficulty":"advanced","question":"Solve the differential equation y'' - 2y' + y = 0.","expected":"(A + B*x)*exp(x)","check":"ode_solution","check_args":{"ode":"Derivative(y(x), x, 2) - 2*Derivative(y(x), x) + y(x)","var":"x","func":"y"},"book_pages":[317,332]}
{"id":"de-06","unit":5,"unit_title":"Differential Equations","topic":"separable, with initial condition","difficulty":"basic","question":"Solve dy/dx = x*y given that y = 1 when x = 0.","expected":"exp(x**2/2)","check":"ode_solution","check_args":{"ode":"Derivative(y(x), x) - x*y(x)","var":"x","func":"y","ic":{"0":1}},"book_pages":[308,316]}
{"id":"rv-01","unit":9,"unit_title":"Random Variables","topic":"discrete distribution, normalising constant","difficulty":"basic","question":"A discrete random variable X has P(X = x) = k*x for x = 1, 2, 3, 4. Find the value of k.","expected":"1/10","check":"numeric","check_args":{"tolerance":1e-09},"book_pages":[464,489]}
{"id":"rv-02","unit":9,"unit_title":"Random Variables","topic":"discrete expectation","difficulty":"basic","question":"A discrete random variable X has P(X = x) = x/10 for x = 1, 2, 3, 4. Find E(X).","expected":"3","check":"numeric","check_args":{"tolerance":1e-09},"book_pages":[464,489]}
{"id":"rv-03","unit":9,"unit_title":"Random Variables","topic":"continuous expectation","difficulty":"intermediate","question":"A continuous random variable X has probability density function f(x) = 3x^2 for 0 <= x <= 1 and zero elsewhere. Find E(X).","expected":"3/4","check":"numeric","check_args":{"tolerance":1e-09},"book_pages":[490,540]}
{"id":"rv-04","unit":9,"unit_title":"Random Variables","topic":"continuous variance","difficulty":"advanced","question":"A continuous random variable X has probability density function f(x) = 3x^2 for 0 <= x <= 1 and zero elsewhere. Find Var(X).","expected":"3/80","check":"numeric","check_args":{"tolerance":1e-09},"book_pages":[490,540]}
{"id":"rv-05","unit":9,"unit_title":"Random Variables","topic":"binomial distribution","difficulty":"intermediate","question":"X follows a binomial distribution with n = 5 and p = 0.2. Find P(X = 2), correct to four decimal places.","expected":"0.2048","check":"numeric","check_args":{"tolerance":0.0001},"book_pages":[464,489]}
