    ],
    "solution": [
      {
        "text": "x − 5 changes sign at x = 5, so split the integral there.",
        "tex": "\\int_0^{10} |x - 5|\\,dx = \\int_0^5 (5 - x)\\,dx + \\int_5^{10} (x - 5)\\,dx"
      },
      {
        "text": "Integrate each part.",
        "tex": "= \\left[5x - \\frac{x^2}{2}\\right]_0^5 + \\left[\\frac{x^2}{2} - 5x\\right]_5^{10}"
      },
      {
        "text": "Substitute the limits.",
        "tex": "= \\frac{25}{2} + \\left(0 - \\left(-\\frac{25}{2}\\right)\\right) = \\frac{25}{2} + \\frac{25}{2} = 25"
      }
