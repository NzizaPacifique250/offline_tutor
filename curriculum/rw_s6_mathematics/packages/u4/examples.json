    ],
    "source_label": "Example 4.62",
    "question": {
      "text": "Work out the integral of |x − 1| from −2 to 2.",
      "tex": "\\int_{-2}^{2} |x - 1|\\,dx"
    },
    "steps": [
      {
        "text": "x − 1 changes sign at x = 1: |x − 1| = −x + 1 for x ≤ 1 and x − 1 for x ≥ 1. Split the integral there.",
        "tex": "\\int_{-2}^{2} |x - 1|\\,dx = \\int_{-2}^{1} (-x + 1)\\,dx + \\int_{1}^{2} (x - 1)\\,dx"
      },
      {
        "text": "Integrate each part.",
        "tex": "= \\left[-\\frac{x^2}{2} + x\\right]_{-2}^{1} + \\left[\\frac{x^2}{2} - x\\right]_{1}^{2}"
      },
      {
        "text": "Substitute the limits.",
        "tex": "= \\left(-\\frac{1}{2} + 1\\right) - (-2 - 2) + (2 - 2) - \\left(\\frac{1}{2} - 1\\right) = 5"
      }
    ],
    "answer_tex": "\\int_{-2}^{2} |x - 1|\\,dx = 5",
    "review": {
      "status": "developer-test",
      "reviewed_by": null,
      "date": null
    }
  }
]
