    "source_label": "Example 4.60",
    "question": {
      "text": "Determine the value of the definite integral of x³ from 1 to 2.",
      "tex": "\\int_1^2 x^3\\,dx"
    },
    "steps": [
      {
        "text": "Find an antiderivative of x³.",
        "tex": "\\int x^3\\,dx = \\frac{x^4}{4}"
      },
      {
        "text": "Evaluate it at the upper limit and subtract its value at the lower limit.",
        "tex": "\\int_1^2 x^3\\,dx = \\left[\\frac{x^4}{4}\\right]_1^2 = \\frac{2^4}{4} - \\frac{1^4}{4} = \\frac{16}{4} - \\frac{1}{4} = \\frac{15}{4}"
      }
    ],
    "answer_tex": "\\int_1^2 x^3\\,dx = \\frac{15}{4}",
    "review": {
      "status": "developer-test",
      "reviewed_by": null,
      "date": null
    }
  },
  {
    "id": "rw-s6-am.u4.ex.02",
    "lesson": "rw-s6-am.u4.l19",
