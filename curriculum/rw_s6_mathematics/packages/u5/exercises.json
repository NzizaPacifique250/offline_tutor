    "prompt": {
      "text": "Find the solution of dy/dx = (1 + y²)/(1 + x²) that satisfies y(0) = 1. Give y as a single fraction in x.",
      "tex": "\\frac{dy}{dx} = \\frac{1 + y^2}{1 + x^2}, \\qquad y(0) = 1"
    },
    "answer": {
      "check": "ode_solution",
      "expected": "(1 + x)/(1 - x)",
      "check_args": {
        "ode": "Derivative(y(x), x) - (1 + y(x)**2)/(1 + x**2)",
        "var": "x",
        "func": "y",
        "ic": {
          "0": 1
        },
        "sample": [
          -0.5,
          -0.2,
          0.2,
