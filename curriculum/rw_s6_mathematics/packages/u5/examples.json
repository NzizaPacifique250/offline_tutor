    "question": {
      "text": "Solve dy/dx = (x² + 1)/4.",
      "tex": "\\frac{dy}{dx} = \\frac{x^2 + 1}{4}"
    },
    "steps": [
      {
        "text": "Separate the variables.",
        "tex": "\\frac{dy}{dx} = \\frac{x^2 + 1}{4} \\iff 4\\,dy = (x^2 + 1)\\,dx"
      },
      {
        "text": "Integrate both sides.",
        "tex": "\\int 4\\,dy = \\int (x^2 + 1)\\,dx \\implies 4y = \\frac{x^3}{3} + x + c"
      },
      {
        "text": "Divide by 4, writing c for the new constant c/4.",
        "tex": "y = \\frac{x^3}{12} + \\frac{x}{4} + c \\quad \\text{(general solution)}"
      }
    ],
    "answer_tex": "y = \\frac{x^3}{12} + \\frac{x}{4} + c",
    "review": {
