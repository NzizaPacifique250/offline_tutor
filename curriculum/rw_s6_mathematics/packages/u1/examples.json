    "question": {
      "text": "Evaluate z₁ − z₂ if z₁ = 1 − 2i and z₂ = 9 + 3i.",
      "tex": "z_1 - z_2 \\quad \\text{where} \\quad z_1 = 1 - 2i,\\; z_2 = 9 + 3i"
    },
    "steps": [
      {
        "text": "Subtract the real parts and the imaginary parts separately.",
        "tex": "(1 - 2i) - (9 + 3i) = (1 - 9) + (-2 - 3)\\,i"
      },
      {
        "text": "Simplify each part.",
        "tex": "= -8 - 5i"
      }
    ],
    "answer_tex": "z_1 - z_2 = -8 - 5i",
