    "prompt": {
      "text": "Find the mean of this probability distribution.",
      "tex": "\\begin{array}{c|cccc} x & 0 & 1 & 2 & 3 \\\\ \\hline P(X = x) & 0.1 & 0.2 & 0.4 & 0.3 \\end{array}"
    },
    "answer": {
